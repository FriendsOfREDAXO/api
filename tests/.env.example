## Copy this file to tests/.env and fill in your local values.
## tests/.env is gitignored.

# Base URL of the running REDAXO 6 instance to test against, without trailing slash.
API_TEST_BASE_URL=https://example.localhost
API_TEST_API_PREFIX=/api
API_TEST_VERIFY_SSL=0
API_TEST_TIMEOUT=30
API_TEST_DEBUG=1

# Bearer token: create one in Backend -> API -> Token and grant it ALL scopes.
API_TEST_TOKEN=

# Optional: a second token with a *limited* set of scopes, used to verify scope enforcement.
# It must have the scope behind ALLOWED_PATH and must NOT have the one behind DENIED_PATH.
# Leave empty to skip the scope-enforcement tests.
API_TEST_RESTRICTED_TOKEN=
# A scope this token DOES have (test asserts 200). Path under /api/, no leading slash.
API_TEST_RESTRICTED_TOKEN_ALLOWED_PATH=structure/articles
# A scope this token DOES NOT have (test asserts 401).
API_TEST_RESTRICTED_TOKEN_DENIED_PATH=users

# Backend admin credentials, used by the /api/backend/... session-auth tests.
# Leave the password empty to skip them.
API_TEST_ADMIN_LOGIN=admin
API_TEST_ADMIN_PASSWORD=

# Existing ids that must be present in the database.
API_TEST_EXISTING_ARTICLE_ID=1
API_TEST_EXISTING_CATEGORY_ID=1
API_TEST_EXISTING_CLANG_ID=1

# REDAXO 6 identifies templates and modules by string key. The template key must exist;
# leave the module key empty to have the suite pick the first module the API reports.
API_TEST_EXISTING_TEMPLATE_KEY=default
API_TEST_EXISTING_MODULE_KEY=

# Column name of an art_* metainfo field declared by the project's meta schema, e.g. art_subtitle.
# Leave empty to skip the metainfo value tests (a fresh REDAXO 6 ships no meta schema).
API_TEST_METAINFO_ARTICLE_FIELD=
